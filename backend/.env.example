# backend/.env.example
DATABASE_URL=postgresql+asyncpg://yunshu:change_me@localhost:5432/yunshu
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=10080
DEFAULT_MODEL=best-1
EMBEDDING_MODEL=text-embedding-v3-small
EMBEDDING_API_BASE=http://exacmple.com/v1
EMBEDDING_API_KEY=sk-xxx
MODEL_API_BASE=https://api.example.com/v1
MODEL_API_KEY=sk-xxx
FRONTEND_ORIGINS=http://localhost:5173

# ===== 钉钉企业内部应用对接（M1-M4：登录 / 组织同步 / OA 审批）=====
# 未配置 DINGTALK_CLIENT_ID/SECRET 时钉钉功能自动禁用（dingtalk_enabled=false，Stream 与扫码均不启动）
DINGTALK_CLIENT_ID=dingxxx                      # Client ID（原 AppKey），开发者后台 → 应用 → 凭证与基础信息
DINGTALK_CLIENT_SECRET=xxx                      # Client Secret（原 AppSecret），同上
DINGTALK_CORP_ID=ding9f50b15bxxxx16741          # 企业组织 ID（扫码登录 sns 签名需要）
DINGTALK_AGENT_ID=11xxxxx                       # H5 微应用 agentId（审批推送 microappAgentId / 工作台免登）
DINGTALK_STREAM_ENABLED=true                    # 是否启动 Stream 事件订阅常驻（审批回写/组织增量事件必须 true）
DINGTALK_SYNC_INTERVAL_MINUTES=60               # 组织同步定时兜底间隔（分钟）
# 审批类目 → 钉钉 OA 审批模板 processCode 映射（JSON 对象；模板须含「审批标题」单行输入 +「审批详情」多行文本两个同名控件，否则推送报 formConverterError）
DINGTALK_OA_PROCESS_CODES={"tool_call":"PROC-XXX","experience_promotion":"PROC-YYY"}
DINGTALK_AUTO_DEPT_OWNER_ROLE=false             # 可选：钉钉部门主管自动映射为本地 dept_owner（默认关，角色体系本地维护）